# ZACC Compliance Portal — Client (Vite) Environment Configuration
# Copy this file to .env if you need to run the backend on a non-default port.
#
# IMPORTANT: this file only matters in DEV mode (`npm run dev`). In
# production (`npm run build` + `npm run start` from the server), the
# frontend is served BY the backend on one port — there is no proxy and
# nothing here applies.
#
# If you changed the backend's port (server/.env's PORT), set the matching
# target here so the dev proxy actually reaches it — otherwise every API
# call will silently be sent to the OLD port and fail (often surfacing as a
# confusing 500/network error on whatever action you try first, e.g. login
# or creating your first institution/user).

# Must match server/.env's PORT (defaults to 4000 if that file doesn't set one).
VITE_API_TARGET=http://localhost:4000

# The port this Vite dev server itself runs on (defaults to 5173).
VITE_DEV_PORT=5173
