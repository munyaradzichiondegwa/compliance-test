# ZACC Compliance Portal — Server Environment Configuration
# Copy this file to .env and fill in real values before deploying to production.
# None of these are required for local demo use — safe defaults are built in —
# but MUST be set to strong, unique values before handling real data.

# Port the API (and, in production, the built frontend) listens on.
PORT=4000

# JWT signing secrets. Generate strong random values for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_MFA_SECRET=

# Comma-separated list of allowed frontend origins for CORS in production,
# e.g. https://compliance.zacc.gov.zw
# Leave blank for local/demo use (reflects request origin).
CORS_ORIGIN=

# Node environment.
NODE_ENV=development
