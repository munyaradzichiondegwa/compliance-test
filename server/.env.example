# Copy to .env (never commit it). In production every secret below is REQUIRED; the server refuses to start without them.
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API (production: the portal's https origin only)
CORS_ORIGIN=http://localhost:5173
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_MFA_SECRET=
# Optional: directory holding the database and uploaded evidence (use a mounted, backed-up volume in production)
DATA_DIR=
